#!/usr/bin/env bash
# Hermes Mascot Desktop Launcher

# Find mutter Xwayland auth so WindowStaysOnTopHint and coordinates work in GNOME
AUTH_FILE=$(ls /run/user/$(id -u)/.mutter-Xwaylandauth.* 2>/dev/null | head -n 1)
if [ -n "$AUTH_FILE" ]; then
    export XAUTHORITY="$AUTH_FILE"
    export DISPLAY="${DISPLAY:-:0}"
    export QT_QPA_PLATFORM=xcb
else
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SCRIPT_DIR="$HOME/.local/share/hermes-mascot"

PID=$(pgrep -f "python.*hermes-mascot/mascot.py")
if [ -n "$PID" ]; then
    if [ "$1" == "stop" ]; then
        kill "$PID" && echo "Hermes Mascot stopped."
        exit 0
    elif [ "$1" == "restart" ]; then
        kill "$PID"
        sleep 1
    else
        echo "Hermes Mascot is already running (PID: $PID)."
        exit 0
    fi
fi

if [ "$1" == "stop" ]; then
    echo "Hermes Mascot is not running."
    exit 0
fi

nohup python3 "$SCRIPT_DIR/mascot.py" > /tmp/hermes-mascot.log 2>&1 &
echo "Hermes Mascot launched in background (PID: $!)."
